{
  "name": "@portfolio/feedback-classifier",
  "version": "0.0.1",
  "private": true,
  "description": "Lambda handler for 0005-classifier-flow: SNS feedback event -> Bedrock classification -> SES email.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1134.0",
    "@aws-sdk/client-sesv2": "^3.1134.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.28.1",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
