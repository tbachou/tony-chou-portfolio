# This project's own Postgres, separate from the portfolio's (spec 0010).
# Use the standard postgres:// form, not prisma+postgres://. The runtime
# connects through @prisma/adapter-pg (node-postgres), which cannot parse
# the Accelerate scheme.
#
# sslmode is spelled verify-full rather than require, and the difference is
# not cosmetic. node-postgres currently treats require as an alias for
# verify-full, so the certificate and the hostname are both checked. From
# pg v9 and pg-connection-string v3 that changes to libpq's meaning, where
# require encrypts but verifies nothing, which is open to a machine in the
# middle. Saying verify-full asks for what we already get today and keeps
# getting it after that upgrade, instead of being quietly downgraded by it.
PIPELINE_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full"
