// Spec 0010, slice 1: the two time axes.
//
// Every fact carries two timestamps. `validTime` is when the fact was true in
// the river; `recordedAt` is when this pipeline learned it. Keeping both is the
// only way to reconstruct what was knowable at a past moment, which is what
// makes the later backtest mean anything.
//
// Slice 1 covers Gauge, Observation and PipelineRun. Slice 2 adds
// ModelVersion, Prediction and Score. Slice 3 adds WeatherForecast.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Provisional readings are subject to revision; approved ones have been
/// reviewed by USGS. The provisional to approved transition is the single
/// event this store most wants to capture, so it is compared on ingest just
/// as the value is.
enum Qualifier {
  PROVISIONAL
  APPROVED
}

/// Every scheduled job records itself, so a silent failure of any of them is
/// visible. Slice 1 only writes USGS_INGEST and USGS_RESCAN; the rest are
/// declared now so later slices add rows, not a migration to the enum.
enum PipelineJob {
  USGS_INGEST
  USGS_RESCAN
  OPEN_METEO_INGEST
  PREDICT
  SCORE
  RETRAIN
}

/// PARTIAL means the source responded but returned fewer intervals than the
/// requested window implies, which is how a sensor outage shows up. A gap is
/// never stored as a row; it is derived at read time from missing validTime
/// slots.
enum RunStatus {
  OK
  PARTIAL
  FAILED
}

/// Baselines and learned models are the same kind of thing to this schema, on
/// purpose. Nothing in the codebase branches on which one it is looking at, so
/// comparing them is structural rather than bolted on afterwards.
enum ModelKind {
  BASELINE
  MODEL
}

/// What the river was doing at one instant. Two tables carry it, meaning two
/// different instants on purpose (spec 0010 child, prediction intervals):
/// Prediction.issueRegime is the river when the forecast was made, which is
/// all a forecaster can see; Score.regime is the river when it came true,
/// which is what decides whether the forecast was any good. Intervals draw on
/// the first, reporting splits by the second, and the gap between them is
/// itself the forecasting problem.
///
/// FALLING arrives with spec 0010's falling regime child. Postgres will not
/// let a newly added enum value be used in the transaction that adds it, and
/// Prisma runs each migration in one, so this value lands in a migration of
/// its own ahead of any code that can write it. PEAK keeps its name and
/// narrows its meaning to the crest and the plateau, because renaming an enum
/// value would rewrite every stored row to buy a better word.
enum Regime {
  BASEFLOW
  RISING
  PEAK
  FALLING
}

model Gauge {
  id               String   @id @default(cuid())
  usgsSiteId       String   @unique
  name             String
  lat              Float
  lon              Float
  drainageAreaSqMi Float?
  /// IANA zone for this gauge, used to resolve calendar days for climatology.
  /// Stored values are always UTC regardless.
  timezone         String
  /// The denominator floor for percentage error, the 5th percentile of this
  /// gauge's historical flow.
  ///
  /// Frozen here after the first scoring run derives it, rather than being
  /// recomputed every run. The spec calls it a constant and it has to behave
  /// like one: a floor that drifts as the record grows would give two scores
  /// of the same prediction, written months apart when a revision lands,
  /// percentages on different scales with nothing recording the difference.
  /// Null means it has not been derived yet. Correct it by hand if the first
  /// run ever sees an unrepresentative store.
  flowFloorCfs     Float?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  observations     Observation[]
  predictions      Prediction[]
  weatherForecasts WeatherForecast[]

  @@map("gauges")
}

/// Append only. Nothing in the codebase issues an update or delete against
/// this table; a revised reading is a new row with a later recordedAt.
model Observation {
  id          String      @id @default(cuid())
  gaugeId     String
  gauge       Gauge       @relation(fields: [gaugeId], references: [id])
  /// When the reading was true at the gauge.
  validTime   DateTime
  /// When this pipeline learned it. USGS exposes no per value revision
  /// timestamp, so ingest time is the only honest source.
  recordedAt  DateTime
  valueCfs    Float
  qualifier   Qualifier
  ingestRunId String
  ingestRun   PipelineRun @relation(fields: [ingestRunId], references: [id])

  @@unique([gaugeId, validTime, recordedAt])
  @@index([gaugeId, validTime, recordedAt(sort: Desc)])
  @@map("observations")
}

/// What rain was *forecast* for one hour, at one lead time, by one pinned
/// model. The model must learn what was expected rather than what fell:
/// training on the observed column hands the forecaster perfect weather
/// foresight it will never have live, and the leakage arrives disguised as a
/// good backtest.
///
/// Append only, exactly like Observation. Nothing updates or deletes a row; a
/// revised forecast is a new row with a later recordedAt. Without that third
/// timestamp an Open-Meteo re-analysis of its own archive would overwrite
/// history invisibly, which is the failure Observation already exists to
/// prevent, and weather is no reason to make an exception.
///
/// The three timestamps are three different questions and all three are
/// needed. validTime is when the weather is expected to happen, issuedAt is
/// when it was forecast, recordedAt is when this pipeline fetched it.
model WeatherForecast {
  id          String      @id @default(cuid())
  gaugeId     String
  gauge       Gauge       @relation(fields: [gaugeId], references: [id])
  /// When the forecast weather is expected to occur.
  validTime   DateTime
  /// How far ahead this value was forecast, 24 times the N of the Open-Meteo
  /// column it came from.
  ///
  /// Canonical: issuedAt is derived from this, never the other way round.
  /// Deriving in the other direction would let a rounding difference forge a
  /// duplicate the unique key could not catch. Held at 24 or more by a check
  /// constraint as well as by the parser, because the two catch different
  /// mistakes: rain that arrives with a shorter lead is knowledge from the
  /// future wearing a forecast's clothes.
  leadHours   Int
  /// validTime minus leadHours. Nominal rather than observed: the Previous
  /// Runs endpoint does not report a run's true initialisation time, so this
  /// asserts a round number the real run may sit a few hours either side of.
  /// Stored because the archive knowability axis reads it, not validTime.
  issuedAt    DateTime
  /// When this pipeline learned it, its own wall clock, as Observation does.
  recordedAt  DateTime
  precipMm    Float
  tempC       Float?
  /// The pinned model name, stored literally. best_match is never requested:
  /// it is a selector, not a model, and which model backs it can change, which
  /// would put a silent inhomogeneity into a training set of only two and a
  /// half years.
  model       String
  ingestRunId String
  ingestRun   PipelineRun @relation(fields: [ingestRunId], references: [id])

  @@unique([gaugeId, validTime, leadHours, model, recordedAt])
  @@index([gaugeId, model, leadHours, validTime])
  @@map("weather_forecasts")
}

/// One version of one forecaster. A baseline is a row here exactly like a
/// trained model is, differing only in `kind` and in having nothing to train.
model ModelVersion {
  id               String    @id @default(cuid())
  name             String    @unique
  kind             ModelKind
  trainedAt        DateTime?
  trainWindowStart DateTime?
  trainWindowEnd   DateTime?
  hyperparams      Json?
  codeSha          String?
  /// Retraining writes a new version and deactivates the one it supersedes.
  /// Rows are never deleted, because predictions reference them forever.
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  predictions Prediction[]

  @@map("model_versions")
}

/// One forecast, made at one moment, for one moment.
///
/// `issuedAt` is when the claim was made and `targetTime` is what it was about.
/// Both are needed: the honesty of the whole scorecard rests on being able to
/// ask what a forecaster knew when it spoke, and a prediction with only a
/// target time cannot answer that.
model Prediction {
  id              String       @id @default(cuid())
  gaugeId         String
  gauge           Gauge        @relation(fields: [gaugeId], references: [id])
  modelVersionId  String
  modelVersion    ModelVersion @relation(fields: [modelVersionId], references: [id])
  issuedAt        DateTime
  targetTime      DateTime
  horizonHours    Int
  centralCfs      Float
  lowerCfs        Float
  upperCfs        Float
  /// The nominal coverage the bounds claim, 0.80 today. Stored per row rather
  /// than assumed, so a later change of policy cannot silently reinterpret
  /// every prediction already made.
  intervalLevel   Float
  /// The river at issuedAt, written by the job that used it to choose the
  /// interval bucket. Nullable because classifyRegime legitimately refuses
  /// when there is too little history to judge, and a forced guess of
  /// BASEFLOW would file storm errors under the easy regime.
  issueRegime     Regime?
  /// True only when the bounds came from the regime conditioned bucket. It
  /// records whether the interval meets AC-21's conditioning requirement, not
  /// merely whether 30 errors existed: pooled quantiles are real data but are
  /// not conditioned, so they are false here too. Defaults to false so an
  /// insert that forgets it cannot claim conditioning it does not have.
  intervalSeeded  Boolean      @default(false)
  /// True when a raw quantile would have broken lower <= central <= upper and
  /// the offending bound was clamped to the central estimate. A model whose
  /// q10 exceeds 1.0 is systematically under predicting, which is a finding
  /// worth keeping rather than an inconvenience to smooth over.
  intervalClamped Boolean      @default(false)
  /// The ratios the bounds were built from, actual / predicted. Null on the
  /// fixed band path, where no quantiles were computed. Stored because the
  /// bucket grows, so bounds written today cannot be reconstructed tomorrow
  /// from the same query.
  q10Used         Float?
  q90Used         Float?
  /// How many errors those quantiles were drawn from.
  bucketSize      Int          @default(0)
  /// True for rows produced by the seeding hindcast rather than issued live.
  /// They are ordinary rows in every other respect: they feed the quantiles,
  /// and every public read filters them out through one helper, so the
  /// scorecard's claim to score every prediction it ever made stays true.
  hindcast        Boolean      @default(false)

  scores Score[]

  @@unique([gaugeId, modelVersionId, issuedAt, targetTime])
  @@index([targetTime])
  /// The interval bucket query: this model's own scored history at the same
  /// gauge, horizon and issue regime. The hindcast walks roughly 3,580 issue
  /// times and runs this once per prediction, so it is worth an index.
  @@index([gaugeId, modelVersionId, horizonHours, issueRegime])
  @@map("predictions")
}

/// How a prediction actually did, judged against one specific revision of the
/// truth.
///
/// Append only, like observations. When a revision changes what actually
/// happened, the old score is not corrected: a second row is written naming
/// the newer revision. A score can therefore always be explained, because it
/// records which version of reality it was judged against.
model Score {
  id               String     @id @default(cuid())
  predictionId     String
  prediction       Prediction @relation(fields: [predictionId], references: [id])
  scoredAt         DateTime
  actualCfs        Float
  /// The `recordedAt` of the exact observation revision this score used.
  actualRecordedAt DateTime
  absError         Float
  pctError         Float
  withinInterval   Boolean
  /// The river at targetTime. Nullable for the same reason issueRegime is:
  /// classifyRegime can refuse, and a required column would have no legal
  /// value to write when it does.
  regime           Regime?

  @@unique([predictionId, actualRecordedAt])
  @@index([regime])
  @@map("scores")
}

model PipelineRun {
  id          String      @id @default(cuid())
  job         PipelineJob
  startedAt   DateTime
  finishedAt  DateTime?
  status      RunStatus
  rowsWritten Int         @default(0)
  windowStart DateTime?
  windowEnd   DateTime?
  error       String?

  observations     Observation[]
  weatherForecasts WeatherForecast[]

  @@index([job, startedAt])
  @@map("pipeline_runs")
}
