// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum StoryOwnership {
  SOLO
  CONTRIBUTED
  CO_LED
}

enum ConversationRole {
  INTERVIEWER
  TONY
}

enum FeedbackSource {
  beta
  portfolio
}

enum FeedbackCategory {
  bug
  feature
  other
}

// Where a Grade Guesser photo came from (spec 0006, AC-18). Required on every
// row so provenance is data rather than memory: `unlicensed_test` marks an
// image borrowed for testing, and the served set refuses to carry one once
// GRADE_GAME_ENABLED is true, so a borrowed photo cannot reach a released
// game by being forgotten.
enum GradePhotoSource {
  own_photo
  permission_given
  licensed
  unlicensed_test
}

model Story {
  id              String         @id @default(cuid())
  title           String
  ownership       StoryOwnership
  engagement      String
  summary         String
  requiredFraming String?
  topics          Topic[]
}

model Topic {
  id                String             @id @default(cuid())
  slug              String             @unique
  label             String
  description       String
  sortOrder         Int
  stories           Story[]
  conversationTurns ConversationTurn[]
}

model ConversationTurn {
  id             String           @id @default(cuid())
  conversationId String
  topic          Topic            @relation(fields: [topicId], references: [id])
  topicId        String
  turnIndex      Int
  role           ConversationRole
  text           String
  tokenCount     Int
  hashedIp       String
  createdAt      DateTime         @default(now())

  @@unique([conversationId, turnIndex, role])
  @@index([conversationId])
  @@index([createdAt])
  @@index([hashedIp])
}

model DailyUsageCounter {
  date       DateTime @id @db.Date
  turnCount  Int      @default(0)
  tokenCount Int      @default(0)
}

// Beta (the return-to-climbing rehab planner, spec 0004) writes exactly two
// anonymous counter tables and nothing else: no injury details, goals text,
// or generated plan content is ever persisted (AC-6). planCount stays
// success-only (AC-8); the other columns are anonymous daily tallies of
// blocked/failed outcomes (errors, red-flag blocks, refusals) and rate-limit
// rejections (in-memory throttle, per-IP cap, global cap) — still zero
// visitor content. Unrelated to the "beta access" wording on AccessRequest
// below.
model BetaDailyUsageCounter {
  date                DateTime @id @db.Date
  planCount           Int      @default(0)
  tokenCount          Int      @default(0)
  errorCount          Int      @default(0)
  redFlagCount        Int      @default(0)
  refusalCount        Int      @default(0)
  throttledCount      Int      @default(0)
  ipCappedCount       Int      @default(0)
  globalCappedCount   Int      @default(0)
  // Spec 0005 guardrails child. Neither is a refund reason: a guard failure
  // still delivers a complete plan (so planCount increments as normal), and
  // an injection block happens before a slot is reserved.
  guardBlockCount     Int      @default(0)
  injectionBlockCount Int      @default(0)
}

model BetaIpDailyCount {
  hashedIp String
  date     DateTime @db.Date
  count    Int      @default(0)

  @@id([hashedIp, date])
}

// Beta-access requests for the standalone Electron apps showcased as
// portfolio project pages (Panel, Carryover). appSlug is a plain String
// (not an enum FK) so a new app can be added on the web side without a
// migration here. Approval is manual, done from /internal/access-requests.
model AccessRequest {
  id          String              @id @default(cuid())
  email       String
  appSlug     String
  status      AccessRequestStatus @default(PENDING)
  downloadUrl String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([email, appSlug])
  @@index([appSlug])
  @@index([status])
}

// Anonymous visitor feedback (spec 0005 child: feedback intake). Append
// only, no update or delete API. No PII fields exist or may be added here
// without a new spec (AC-I2); hashedIp serves rate limiting only. Message
// text lands here and, fire-and-forget, in one SNS publish — nowhere else
// (inline rationale, spec 0005-feedback-intake).
model Feedback {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())
  source    FeedbackSource
  category  FeedbackCategory?
  message   String            @db.VarChar(2000)
  hashedIp  String

  @@index([hashedIp])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// The Grade Guesser photo pool (spec 0006 R2). Api-side rather than a web
// asset for the same reason the manifest it replaces was: the row carries
// `trueGrade`, so the day's answer never reaches the client bundle (AC-2).
//
// The bytes live in a private S3 bucket under `objectKey`; nothing about the
// image is served from the web app's public directory, so turning the
// feature flag off genuinely hides the photos (AC-13). Object keys are
// random rather than derived from the slug, which keeps gym circuit colour
// words (a grade hint) out of the presigned URL a visitor sees (AC-2), and
// means a rollback delete can only ever remove the object its own upload
// just wrote (AC-9).
//
// Rows are deactivated, never deleted: `active` is what the served set
// filters on, and GradeProblem's foreign key is onDelete: Restrict so the
// database enforces it rather than a habit.
//
// `objectKey` carries a second job as of 2026-08-22: its random hex basename
// IS the problem's public id (AC-23). No `publicId` column exists on purpose
// — the value is already unique, already opaque, already server generated and
// already on every row, so adding one would have meant a backfill and a
// collision policy for nothing.
model GradePhoto {
  id          String           @id
  objectKey   String           @unique
  contentType String
  trueGrade   Int
  source      GradePhotoSource
  sourceNote  String?
  note        String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  problem     GradeProblem?

  @@index([active])
}

// Grade Guesser (the climbing-grade game, spec 0006). One row per PROBLEM,
// created lazily by that problem's first guess. Everything a visitor
// contributes is an anonymous integer: guessCounts is a 9-slot histogram
// indexed by V-grade and plays is a bare tally (AC-6). No visitor identity,
// no free text, and no per-visitor row exists or may be added here — the
// feature's request DTO is a single validated integer and an opaque id by
// construction. Progress through the set lives only in the browser (AC-24).
//
// Renamed and rekeyed from `GradeDay` on 2026-08-22, when the daily cadence
// was dropped: the primary key moved from `date` to `photoId` and `date` is
// gone, because a fixed set of problems has no days. Production held zero
// rows and the game had never been enabled, so this was a clean rename rather
// than a data migration.
//
// The model* columns cache that problem's single vision call, ever (AC-4):
// null until it lands, filled once, never reset. `photoId` being the primary
// key is what makes the relation strictly one problem per photo, and the
// foreign key is onDelete: Restrict so a photo a problem names can never be
// deleted out from under it.
model GradeProblem {
  photoId         String     @id
  photo           GradePhoto @relation(fields: [photoId], references: [id], onDelete: Restrict)
  modelGrade      Int?
  modelConfidence String?
  observations    String[]   @default([])
  reasoning       String?
  model           String?
  inputTokens     Int        @default(0)
  outputTokens    Int        @default(0)
  guessCounts     Int[]      @default([0, 0, 0, 0, 0, 0, 0, 0, 0])
  plays           Int        @default(0)
  createdAt       DateTime   @default(now())
}
