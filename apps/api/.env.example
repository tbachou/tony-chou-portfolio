DATABASE_URL="prisma+postgres://localhost:51213/?api_key=changeme"
ANTHROPIC_API_KEY="changeme"
ANTHROPIC_MODEL="claude-sonnet-5"

# Provider swap (spec 0005 provider-swap child). "anthropic" (default, or
# unset) keeps the interview simulator on the direct API above, unchanged.
# "bedrock" routes it through Amazon Bedrock instead; Beta always stays on
# the direct path regardless of this flag until the Guardrails child lands.
AI_PROVIDER="anthropic"
# Required only when AI_PROVIDER=bedrock; boot fails fast if unset.
# Cross-region inference profile id for the Sonnet 5 model, us-east-2 (see
# the spec for how this was resolved from the model catalog).
BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-4-5-20250929-v1:0"

# AWS credentials (spec 0005). Define these ONCE: dotenv keeps the LAST
# occurrence of a key, so a second block further down silently wins and
# blanks whatever you set here. Two consumers share this one pair today:
#   1. the feedback SNS publisher (feedback-sns.publisher.ts), used whenever
#      SNS_FEEDBACK_TOPIC_ARN below is set;
#   2. the Bedrock provider (bedrock-anthropic.service.ts), required when
#      AI_PROVIDER=bedrock — boot fails fast if any of the three are unset.
# Open design issue, left for a human: the specs call for two distinct IAM
# users (one for SNS publish, one for Bedrock) so either can be revoked
# alone, but both SDK clients resolve from this single ambient credential
# pair, so one process cannot hold both.
# Enter these in Render's env UI, never in code or state.
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID="changeme"
AWS_SECRET_ACCESS_KEY="changeme"

# Grade Guesser's private photo bucket (spec 0006). Local development needs
# this AND the AWS credentials above regardless of AI_PROVIDER: reading photo
# bytes and presigning URLs go through AWS whichever model provider is in use.
GRADE_PHOTO_BUCKET="portfolio-grade-photos-635474720027"

IP_HASH_SALT="changeme"
TURN_PAIR_CAP=5
DAILY_TURN_CAP=300
DAILY_TOKEN_CAP=150000
CORS_ORIGIN="http://localhost:3000"
PORT=3001
BETTER_AUTH_SECRET="changeme"
INTERNAL_ADMIN_EMAIL="changeme"
INTERNAL_ADMIN_PASSWORD="changeme"
# Feedback intake (spec 0005). Absent SNS_FEEDBACK_TOPIC_ARN disables SNS
# publishing (intake still works, logs one WARN at boot) — see
# apps/api/src/modules/feedback/feedback-sns.publisher.ts. The publish uses
# the shared AWS credentials defined above.
SNS_FEEDBACK_TOPIC_ARN=""
