DATABASE_URL="prisma+postgres://localhost:51213/?api_key=changeme"
ANTHROPIC_API_KEY="changeme"
ANTHROPIC_MODEL="claude-sonnet-5"

# Provider swap (spec 0005 provider-swap child). "anthropic" (default, or
# unset) keeps the interview simulator on the direct API above, unchanged.
# "bedrock" routes it through Amazon Bedrock instead; Beta always stays on
# the direct path regardless of this flag until the Guardrails child lands.
AI_PROVIDER="anthropic"
# Required only when AI_PROVIDER=bedrock; boot fails fast if any are unset.
# Cross-region inference profile id for the Sonnet 5 model, us-east-2 (see
# the spec for how this was resolved from the model catalog).
BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-4-5-20250929-v1:0"
AWS_REGION="us-east-2"
# Console-created IAM user's keys, distinct from the SNS publisher user so
# either credential can be revoked alone. Enter these in Render's env UI,
# never in code or state.
AWS_ACCESS_KEY_ID="changeme"
AWS_SECRET_ACCESS_KEY="changeme"

IP_HASH_SALT="changeme"
TURN_PAIR_CAP=5
DAILY_TURN_CAP=300
DAILY_TOKEN_CAP=150000
CORS_ORIGIN="http://localhost:3000"
PORT=3001
BETTER_AUTH_SECRET="changeme"
INTERNAL_ADMIN_EMAIL="changeme"
INTERNAL_ADMIN_PASSWORD="changeme"
# Feedback intake (spec 0005). Absent SNS_FEEDBACK_TOPIC_ARN disables SNS
# publishing (intake still works, logs one WARN at boot) — see
# apps/api/src/modules/feedback/feedback-sns.publisher.ts.
SNS_FEEDBACK_TOPIC_ARN=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
