{
  "name": "tony-chou-portfolio",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/lambda/feedback-classifier"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:feedback-classifier": "npm run build --workspace=infra/lambda/feedback-classifier",
    "lint": "eslint . --max-warnings 25",
    "check:skills": "node scripts/check-skills.mjs",
    "build:shared": "npm run build --workspace=@portfolio/shared",
    "postinstall": "npm run build:shared && npm run build:streamflow",
    "build:streamflow": "npm run build --workspace=@portfolio/streamflow"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.66.0"
  }
}
